# Ahadi shelf-count demo — copy to demo/.env and edit.
# All AI access is one OpenAI-compatible endpoint. See docs/AI-PROVIDERS.md.

# ---- the only three settings you normally need ------------------------------
AHADI_AI_BASE_URL=https://api.openai.com/v1
AHADI_AI_API_KEY=
AHADI_AI_MODEL=gpt-4o

# openai = use the endpoint above.  mock = offline heuristic, no key needed.
AHADI_PROVIDER=openai

# ---- optional ---------------------------------------------------------------
# Some gateways reject structured output. Set to 0 if you get 400s.
AHADI_AI_JSON_SCHEMA=1
AHADI_AI_MAX_TOKENS=1800
AHADI_AI_TEMPERATURE=0
AHADI_AI_RETRIES=2
AHADI_TIMEOUT=120

# Image is downscaled to this max side before being sent to the model.
# 1536 is a good default. Raise to 2048 for shelves with many small watches.
AHADI_MAX_SIDE=1536
AHADI_JPEG_QUALITY=86

# Diff tuning. Lower = more sensitive (more false alarms).
AHADI_MATCH_MIN=0.40
AHADI_MOVED_MIN=0.72
AHADI_SAME_OBJECT_MIN=0.62
# How close two detections must be to count as the same *place*. Below this a
# pair is treated as moved rather than unchanged. Raise if a shifting camera
# produces spurious "moved" reports; lower if real moves read as missing+new.
AHADI_SAME_PLACE_MIN=0.45

# Server
AHADI_HOST=0.0.0.0
AHADI_PORT=8080
# Where demo data (sqlite + photos) lives.
#AHADI_DATA=/var/lib/ahadi-demo
# Force the URL used in QR codes (behind a reverse proxy).
#AHADI_PUBLIC_BASE=http://192.168.1.50:8080
